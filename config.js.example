/* Example: audit-only config for forks / public deploys.
   Copy to config.js and set WANTNOT_AUDIT_CLIENT_ID from your own Entra
   app registration. A client ID is a public identifier, not a credential —
   this app is a public client with no secret; PKCE protects the token exchange.

   For wantnot-audit (audit.wantnot.ebbwater.net) the production config.js is
   generated at deploy time from the GitHub secret AUDIT_CLIENT_ID — it is
   not committed. Forks should run tools/create_audit_app.sh (or infra/05-audit-app.sh
   equivalent) to create their own multi-tenant app registration.

   Optional pin: window.WANTNOT_AUDIT_TENANT = 'your-tenant-guid';
   then sign-in is locked to that tenant; URL ?tenant= overrides it.
*/
window.WANTNOT_AUDIT_CLIENT_ID = 'REPLACE_ME';
window.WANTNOT_API_BASE = 'https://func-wantnot-4dc52f.azurewebsites.net'; // or https://wantnot.ebbwater.net for the custom domain
// Optional: window.WANTNOT_AUDIT_TENANT = 'your-tenant-guid';

/* Analytics (GTM W3). Both empty is the shipped state: no beacon, no request,
   no vendor code, and the CSP is unchanged. To measure page views, set
   `provider` to 'plausible' or 'fathom' and `site` to that provider's site id.
   Setting a site id also needs the matching connect-src origin in the CSP —
   tools/analytics_csp.py applies it to the deployed config from this file, so
   the committed staticwebapp.config.json stays unchanged. Confirm the endpoint
   and payload in analytics.js against the provider's documentation first, and
   land the privacy-policy wording in the same release. See docs/ANALYTICS.md. */
window.WANTNOT_ANALYTICS = { provider: '', site: '' };
